import cv2
import os
from tkinter import Tk, Label, Button, Text, Entry, StringVar, END, Frame
from PIL import Image, ImageTk
from datetime import datetime
import pytesseract
import subprocess

# 确保 tesseract 路径正确
pytesseract.pytesseract.tesseract_cmd = r'/usr/bin/tesseract'

# 保存目录
save_dir = os.path.expanduser("~/ocr")
os.makedirs(save_dir, exist_ok=True)

# 摄像头初始化
camera_index = 0
cap = cv2.VideoCapture(camera_index)
if not cap.isOpened():
    print("无法打开摄像头！")
    exit()

# 获取摄像头分辨率
width = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH))
height = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))

# 初始化 GUI
root = Tk()
root.title("OCR 识别工具")
root.geometry(f"{width+300}x{height+100}")  # 窗口大小

# 实时画面显示区
frame = Frame(root, width=width, height=height)
frame.grid(row=0, column=0, rowspan=6)
video_label = Label(frame)
video_label.pack()

# 输入 SN 号
sn_label = Label(root, text="输入 SN 号:")
sn_label.grid(row=0, column=1, padx=10, pady=5)
sn_input = Entry(root, width=30)
sn_input.grid(row=1, column=1, padx=10)

# 日志框
log_label = Label(root, text="日志输出:")
log_label.grid(row=2, column=1, padx=10, pady=5)
log_text = Text(root, width=40, height=10)
log_text.grid(row=3, column=1, padx=10)

# 结果文本框
result_label = Label(root, text="识别结果:")
result_label.grid(row=4, column=1, padx=10, pady=5)
result_text = Text(root, width=40, height=10)
result_text.grid(row=5, column=1, padx=10)

# 全局变量
photo_path = None

def update_video():
    """更新摄像头画面"""
    global photo_path
    ret, frame = cap.read()
    if ret:
        # 转换为 Tkinter 格式
        frame_rgb = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
        img = ImageTk.PhotoImage(Image.fromarray(frame_rgb))
        video_label.imgtk = img
        video_label.configure(image=img)
    root.after(10, update_video)

def start_detection():
    """自动拍照并进行OCR检测"""
    global photo_path
    ret, frame = cap.read()
    if ret:
        # 获取当前时间戳作为文件名
        timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
        photo_path = os.path.join(save_dir, f"photo_{timestamp}.jpg")
        cv2.imwrite(photo_path, frame)  # 保存照片
        log_text.insert(END, f"照片已保存到: {photo_path}\n")
        log_text.see(END)
        
        # 设置 LD_LIBRARY_PATH 环境变量
        os.environ["LD_LIBRARY_PATH"] = "./lib"  # 修改为你的 lib 路径

        # 使用 subprocess 执行外部命令进行 OCR 识别
        command = ["./rknn_ppocr_system_demo", "model/ppocrv4_det.rknn", "model/ppocrv4_rec.rknn", photo_path]
        try:
            result = subprocess.run(command, capture_output=True, text=True, check=True)
            log_text.insert(END, f"检测结果:\n{result.stdout}\n")
            log_text.see(END)

            # 更新 text.txt 内容并显示
            if os.path.exists("text.txt"):
                with open("text.txt", "r") as file:
                    text_content = file.read()
                    result_text.delete(1.0, END)  # 清空结果文本框
                    result_text.insert(END, text_content)  # 显示 text.txt 内容
                    result_text.see(END)

        except subprocess.CalledProcessError as e:
            log_text.insert(END, f"错误: {e.stderr}\n")
            log_text.see(END)
    else:
        log_text.insert(END, "拍照失败！\n")
        log_text.see(END)

def upload_log():
    """上传日志功能"""
    sn = sn_input.get().strip()
    if not sn:
        log_text.insert(END, "SN 号不能为空！\n")
        log_text.see(END)
        return

    # 读取 text.txt 文件中的信息
    rk_info = None
    next_line_info = None  # 用于保存 RK3288 后的下一行信息
    if os.path.exists("text.txt"):
        with open("text.txt", "r") as file:
            lines = file.readlines()
            for i in range(len(lines)):
                stripped_line = lines[i].strip()
                # 找到 RK3288 后的下一行
                if "RK3288" in stripped_line and i + 1 < len(lines):
                    next_line_info = lines[i + 1].strip()  # 获取下一行的内容
                    break

    # 判断是否找到 RK3288 后的下一行信息
    if next_line_info is None:
        log_text.insert(END, "text.txt 中没有 RK3288 后的识别信息，无法上传日志！\n")
        log_text.see(END)
    else:
        log_text.insert(END, f"上传日志:\nSN 号: {sn}\nRK3288 后的识别信息: {next_line_info}\n")

        log_text.see(END)





# 按钮
start_detection_btn = Button(root, text="开始检测", command=start_detection)
start_detection_btn.grid(row=6, column=1, padx=10, pady=5)

upload_log_btn = Button(root, text="上传日志", command=upload_log)
upload_log_btn.grid(row=7, column=1, padx=10, pady=5)

# 开始更新画面
update_video()

# 启动 GUI 主循环
root.mainloop()

# 释放摄像头资源
cap.release()
cv2.destroyAllWindows()
